# Копировать в .env (рядом с docker-compose.yml) и править под себя.
# Конфиг api полностью через env (metrics.config.yaml больше нет).
# vLLM наружу НЕ публикуется: api ходит в vLLM по имени в compose-сети
# (vLLM на хосте вне compose — см. dev-вариант у VLLM_URL).

# ---- vLLM (источник метрик) ----
# Обязателен. vLLM на хосте вне compose (dev-вариант):
# VLLM_URL=http://host.docker.internal:8000
VLLM_URL=http://vllm:8000
# Необязательные (дефолты — в комментариях):
#VLLM_METRICS_PATH=/metrics     # путь к метрикам vLLM
#VLLM_POLL_S=5                  # период опроса, с
#VLLM_MODEL_NAME=               # метка модели (по умолчанию: из /v1/models)
#VLLM_TIMEOUT_S=5               # таймаут запросов, с

# ---- GPU / система (NVML, все GPU хоста) ----
GPU_POLL_S=10
GPU_VISIBLE=all          # все GPU хоста, включая не занятые vLLM
SYS_POLL_S=10

# ---- Логи vLLM (лог-источник; в compose — общий том vllm-logs) ----
LOG_SOURCE_NAME=vllm
LOG_SOURCE_TYPE=file
LOG_SOURCE_PATH=/var/log/vllm/vllm.log
LOG_SOURCE_CONTAINER=vllm            # используется при LOG_SOURCE_TYPE=docker
LOG_POLL_S=1
LOG_RETENTION_DAYS=14

# ---- БД и ретенция ----
SQLITE_PATH=/data/metrics.db
RETENTION_RAW_HOURS=168
RETENTION_HOURLY_DAYS=180
RETENTION_DAILY_DAYS=                # пусто — безлимит

# ---- Стоимость (дефолты тарифов; в UI меняется, история пересчитывается) ----
CURRENCY=USD
RATE_PER_KWH_USD=0.10
BASELINE_WATTS=200
PROMPT_PRICE_PER_M=0.5
COMPLETION_PRICE_PER_M=1.5

# ---- Алерты ----
ALERTS_ENABLED=true
ALERTS_INTERVAL_S=30
# Telegram-webhook (полный URL .../sendMessage?chat_id=...) — либо прямо здесь:
#TELEGRAM_WEBHOOK=https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT>
# либо файлом (рекомендуется): ./secrets/telegram_webhook.txt с URL внутри
# (секция secrets в docker-compose.yml; не нужен — файл создать не нужно
# и/или закомментировать секцию). UI-настройки имеют приоритет.

# ---- vLLM (инференс-контейнер) ----
# Профиль запуска: имя скрипта docker/vllm/scripts/<имя>.sh
# (список доступных — ls docker/vllm/scripts/; новый профиль требует
# docker compose build vllm после добавления скрипта)
VLLM_SCRIPT=fp8
# Модель (путь в контейнере; хостовый каталог смонтирован как /mnt/storage/models)
MODEL=/mnt/storage/models/Qwen3.8-27B-FP8
# Имя модели, которое vLLM отдаёт клиентам/API (опционально;
# по умолчанию = basename(MODEL) в нижнем регистре)
#SERVED_NAME=qwen3.8-27b-fp8
# NCCL-диагностика (временно при отладке старта vLLM):
#NCCL_DEBUG=INFO
# Каталог моделей хоста (в контейнер примонтируется как /mnt/storage/models)
MODELS_DIR=/mnt/storage/models
