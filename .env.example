# Копировать в .env (рядом с docker-compose.yml) и править под себя.
# Весь конфиг api — через env. vLLM живёт процессом НА ХОСТЕ (обёртка
# scripts/vllm-host.sh над ~/bin/work-fp8.sh; в docker — только api и web).
#
# ВАЖНО: inline-комментарии после значения (VALUE # коммент) НЕ использовать —
# docker compose env_file передаёт их как часть значения.

# ---- vLLM (источник метрик; процесс на хосте) ----
# Обязателен. Из api-контейнера хост доступен как host.docker.internal
# (extra_hosts: host-gateway в compose).
VLLM_URL=http://host.docker.internal:8000
# Хост-скрипт vLLM должен слушать 0.0.0.0, а НЕ 127.0.0.1
# (loopback хоста из контейнеров не виден).
# Необязательные (дефолты — в комментариях):
#VLLM_METRICS_PATH=/metrics
#VLLM_POLL_S=5
#VLLM_MODEL_NAME=
#VLLM_TIMEOUT_S=5

# ---- Обёртка vLLM на хосте (scripts/vllm-host.sh; make vllm-start) ----
# Хост-скрипт, запускающий модель (nohup → VLLM_LOG_DIR/vllm.log).
# Другой скрипт (другая модель/квантизация/GPU): поменяйте значение,
# затем `make vllm-stop && make vllm-start` (api-контейнер не трогать —
# он ходит в vLLM по VLLM_URL). Скрипт обязан быть исполняемым и
# слушать --host 0.0.0.0 (не 127.0.0.1). Примеры скриптов — docs/CONFIG.md:
VLLM_SCRIPT=/home/arkalaust/bin/work-fp8.sh
# Каталог логов на хосте (api читает его ro: /var/log/vllm в контейнере):
VLLM_LOG_DIR=/mnt/storage/vllm
# Ротация хост-лога: make install-logrotate (100M×4, copytruncate)

# ---- GPU / система (NVML, все GPU хоста) ----
# Период опроса GPU, с (дефолт 10):
GPU_POLL_S=10
# all или список индексов (0,1):
GPU_VISIBLE=all
# Период опроса системы, с (дефолт 10):
SYS_POLL_S=10

# ---- Логи vLLM (лог-источник api: файл, который пишет хост-обёртка) ----
LOG_SOURCE_NAME=vllm
LOG_SOURCE_TYPE=file
LOG_SOURCE_PATH=/var/log/vllm/vllm.log
# Используется при LOG_SOURCE_TYPE=docker:
#LOG_SOURCE_CONTAINER=
LOG_POLL_S=1
# Ретенция проиндексированных строк, дней (дефолт 14):
LOG_RETENTION_DAYS=14

# ---- БД и ретенция ----
SQLITE_PATH=/data/metrics.db
# Сырые сэмплы, часов (дефолт 168):
RETENTION_RAW_HOURS=168
# Часовые агрегаты, дней (дефолт 180):
RETENTION_HOURLY_DAYS=180
# Суточные, дней; пусто — безлимит:
RETENTION_DAILY_DAYS=

# ---- Стоимость (дефолты тарифов; в UI меняется, история пересчитывается) ----
CURRENCY=USD
RATE_PER_KWH_USD=0.10
BASELINE_WATTS=200
PROMPT_PRICE_PER_M=0.5
COMPLETION_PRICE_PER_M=1.5

# ---- Алерты ----
ALERTS_ENABLED=true
ALERTS_INTERVAL_S=30
# Telegram-webhook (полный URL .../sendMessage?chat_id=...) — либо прямо здесь:
#TELEGRAM_WEBHOOK=https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT>
# либо файлом (рекомендуется): ./secrets/telegram_webhook.txt с URL внутри
# (секция secrets в docker-compose.yml; не нужен — файл создавать не нужно
# и/или закомментировать секцию). UI-настройки имеют приоритет.
