# Копировать в .env (рядом с docker-compose.yml) и править под себя.

# Профиль запуска vLLM: имя скрипта docker/vllm/scripts/<имя>.sh
# (список доступных — ls docker/vllm/scripts/; новый профиль требует
# docker compose build vllm после добавления скрипта)
VLLM_SCRIPT=fp8

# Модель (путь в контейнере; хостовый /mnt/storage/models смонтирован ro)
MODEL=/mnt/storage/models/Qwen3.8-27B-FP8

# Имя модели, которое vLLM отдаёт клиентам/API (опционально;
# по умолчанию = basename(MODEL) в нижнем регистре)
#SERVED_NAME=qwen3.8-27b-fp8
