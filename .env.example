# Копировать в .env (рядом с docker-compose.yml) и править под себя.

# Профиль запуска vLLM: имя скрипта docker/vllm/scripts/<имя>.sh
# (список доступных — ls docker/vllm/scripts/; новый профиль требует
# docker compose build vllm после добавления скрипта)
VLLM_SCRIPT=fp8

# Модель (путь в контейнере; хостовый /mnt/storage/models смонтирован ro)
MODEL=/mnt/storage/models/Qwen3.8-27B-FP8

# Имя модели, которое vLLM отдаёт клиентам/API (опционально;
# по умолчанию = basename(MODEL) в нижнем регистре)
#SERVED_NAME=qwen3.8-27b-fp8

# ---- Пути хоста (заполнить под свой сервер) ----
# conda-окружение 1Cat-vLLM и исходники: нужны ТОЛЬКО на сервере, где env
# собран (для `make stage-vllm` — впевание env в vLLM-образ). На другом
# сервере при переносе образа эти строки не используются.
VLLM_ENV_DIR=/home/arkalaust/miniconda3/envs/1cat-vllm-15
# исходники editable-установки (путь в образе фиксирован: .pth)
VLLM_SRC_DIR=/home/arkalaust/1Cat-vLLM
# каталог моделей хоста (в контейнер примонтируется как /mnt/storage/models)
MODELS_DIR=/mnt/storage/models
# NCCL-диагностика (временно при отладке старта vLLM):
#NCCL_DEBUG=INFO
